# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor (webhooks, notificaciones, jobs). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Personal Access Token (solo scripts de admin: migraciones, OAuth redirects)
# Crear en https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...

# URL pública del sitio (auth callbacks, Stripe return URLs, emails)
# En local el dev server usa puerto 3002 (`npm run dev`).
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Stripe · SALES-6 (solo servidor)
# Local test: sk_test_... + whsec_... desde `stripe listen`
# Producción: sk_live_... o sk_test_... + whsec_... del endpoint en Stripe Dashboard
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Notificaciones internas de pedidos al admin (opcional · SALES-5)
# Si no están configuradas, el pedido se crea igual; solo se omiten emails admin.
# ADMIN_ORDER_NOTIFICATION_EMAIL=operaciones@tudominio.com
# EMAIL_FROM=Radio Shalko <notificaciones@tudominio.com>
# RESEND_API_KEY=re_xxxxxxxx

# Email al cliente (pago, recordatorio carrito — opcional · SALES-6 / SALES-7.2)
# CUSTOMER_ORDER_EMAILS_ENABLED=true

# Job de recordatorios de carrito (opcional · SALES-7.2 / SALES-8)
# Protege POST /api/jobs/cart-reminders — ver GO_LIVE_CHECKLIST_RADIO_SHALKO.md
# CRON_SECRET=your-random-secret
